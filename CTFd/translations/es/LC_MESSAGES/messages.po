msgstr "Confirmación de cambio de contraseña en {ctf_name}"

#: CTFd/views.py:282
msgid ""
"Your password for {ctf_name} has been changed.\n"
"\n"
"If you didn't request a password change you can reset your password here:"
" {url}"
msgstr ""
"Se cambió tu contraseña de {ctf_name}.\n"
"\n"
"Si no fuiste vos, podés restablecer tu contraseña acá: {url}"

#: CTFd/views.py:364
#, python-format
msgid ""
"In order to participate you must either <a href=\"%(url)s\">join or "
"create a team</a>."
msgstr ""
"Para participar, tenés que <a href=\"%(url)s\">unirte a un equipo o crear"
" uno</a>."

#: CTFd/views.py:379
#, python-format
msgid ""
"Your email address isn't confirmed!<br>Please check your email to confirm"
" your email address.<br><br>To have the confirmation email resent please "
"<a href=\"%(url)s\">click here</a>."
msgstr ""
"¡Todavía no confirmaste tu correo!<br>Revisá tu bandeja de entrada para "
"confirmarlo.<br><br>Si querés que te reenviemos el correo de "
"confirmación, <a href=\"%(url)s\">hacé clic acá</a>."

