msgid "OAuth State validation mismatch."
msgstr "Falló la validación de OAuth. Probá de nuevo."

#: CTFd/auth.py:540
msgid "Public registration is disabled. Please try again later."
msgstr "El registro público está deshabilitado. Probá de nuevo más tarde."

#: CTFd/auth.py:559
#, python-format
msgid ""
"Reached the maximum number of teams (%(num)s). Please join an existing "
"team."
msgstr ""
"Se alcanzó la cantidad máxima de equipos (%(num)s). Unite a un equipo "
"existente."

#: CTFd/auth.py:572
#, python-format
msgid "Teams are limited to %(num)d member."
msgid_plural "Teams are limited to %(num)d members."
