#: CTFd/admin/challenges.py:57 CTFd/api/v1/challenges.py:305
#, python-format
msgid ""
"The underlying challenge type (%(type)s) is not installed. This challenge"
" can not be loaded."
msgstr ""
"El tipo de desafío (%(type)s) no está instalado. No se puede cargar este "
"desafío."

#: CTFd/api/__init__.py:62
msgid ""
"You don't have the permission to access the requested resource. It is "
"either read-protected or not readable by the server."
msgstr ""
"No tenés permiso para acceder al recurso solicitado. Está protegido o el "
"servidor no puede leerlo."

#: CTFd/api/__init__.py:70
msgid ""
"The requested URL was not found on the server. If you entered the URL "
"manually please check your spelling and try again."
msgstr ""
"No se encontró la URL solicitada en el servidor. Si la escribiste a mano,"
" revisá que esté bien escrita y probá de nuevo."

