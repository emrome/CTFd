#: CTFd/auth.py:90
#, python-format
msgid "Confirmation email sent to %(email)s!"
msgstr "¡Te enviamos un correo de confirmación a %(email)s!"

#: CTFd/auth.py:106
msgid ""
"This CTF is not configured to send email.<br> Please contact an organizer"
" to have your password reset."
msgstr ""
"Este CTF no está configurado para enviar correos.<br> Pedile a un "
"organizador que restablezca tu contraseña."

#: CTFd/auth.py:118
msgid "Your link has expired"
msgstr "Tu enlace venció"

#: CTFd/auth.py:122
msgid "Your reset token is invalid"
msgstr "Tu enlace para restablecer la contraseña no es válido"

#: CTFd/auth.py:134
msgid ""
"Your account was registered via an authentication provider and does not "
"have an associated password. Please login via your authentication "
"provider."
msgstr ""
"Tu cuenta se registró con un proveedor de autenticación externo y no "
"tiene contraseña. Ingresá con ese proveedor."

#: CTFd/auth.py:143
msgid "Please pick a longer password"
msgstr "Elegí una contraseña más larga"

#: CTFd/auth.py:168
msgid "If that account exists you will receive an email, please check your inbox"
msgstr "Si la cuenta existe, vas a recibir un correo. Revisá tu bandeja de entrada"

#: CTFd/auth.py:178
msgid ""
"The email address associated with this account was registered via an "
"authentication provider and does not have an associated password. Please "
"login via your authentication provider."
msgstr ""
"El correo de esta cuenta se registró con un proveedor de autenticación "
"externo y no tiene contraseña. Ingresá con ese proveedor."

