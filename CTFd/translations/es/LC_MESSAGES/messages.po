msgid "Your username or password is incorrect"
msgstr "El usuario o la contraseña son incorrectos"

#: CTFd/auth.py:451
msgid ""
"OAuth Settings not configured. Ask your CTF administrator to configure "
"MajorLeagueCyber integration."
msgstr ""
"OAuth no está configurado. Pedile al administrador del CTF que configure "
"la integración con MajorLeagueCyber."

