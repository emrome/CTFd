#: CTFd/auth.py:134
msgid ""
"Your account was registered via an authentication provider and does not "
"have an associated password. Please login via your authentication "
"provider."
msgstr ""
"Tu cuenta se registró con un proveedor de autenticación externo y no "
"tiene contraseña. Ingresá con ese proveedor."

#: CTFd/auth.py:143
msgid "Please pick a longer password"
msgstr "Elegí una contraseña más larga"

