#, python-format
msgid "Confirmation email sent to %(email)s!"
msgstr "¡Te enviamos un correo de confirmación a %(email)s!"

#: CTFd/auth.py:106
msgid ""
"This CTF is not configured to send email.<br> Please contact an organizer"
" to have your password reset."
msgstr ""
"Este CTF no está configurado para enviar correos.<br> Pedile a un "
"organizador que restablezca tu contraseña."

